{
  "name": "daily-game",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "A free GitHub Pages site that shows a brand-new AI-generated browser game every day.",
  "engines": {
    "node": ">=23.6.0"
  },
  "imports": {
    "#lib/*": "./lib/*",
    "#scripts/*": "./scripts/*",
    "#src/*": "./src/*",
    "#config/*": "./config/*"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "npm run test:node && npm run test:web",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.web.json",
    "validate": "node --experimental-strip-types scripts/validate-config.ts",
    "rollup": "node --experimental-strip-types scripts/rollup-history.ts",
    "schema": "node --experimental-strip-types scripts/reaction-store-schema.ts",
    "reflect": "node --env-file-if-exists=.env --experimental-strip-types scripts/reflect-lessons.ts",
    "dry-run": "node --env-file-if-exists=.env --experimental-strip-types scripts/call-openrouter.ts --dry-run",
    "generate:local": "node --env-file-if-exists=.env --experimental-strip-types scripts/call-openrouter.ts",
    "build:site": "vite build && node --experimental-strip-types scripts/assemble-site.ts",
    "test:node": "node --experimental-strip-types --test",
    "test:web": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.6",
    "@types/node": "^26.4.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^4.1.11",
    "jsdom": "^29.1.1",
    "playwright": "^1.62.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.7.3",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "@sentry/react": "^10.72.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  }
}
