{
  "name": "daily-game",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "A free GitHub Pages site that shows a brand-new AI-generated browser game every day.",
  "engines": {
    "node": "^24.15.0 || >=26.0.0"
  },
  "imports": {
    "#lib/*": "./lib/*",
    "#actions_pipeline/*": "./actions_pipeline/*",
    "#src/*": "./src/*",
    "#config/*": "./config/*"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "npm run test:node && npm run test:web",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.web.json",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "npm run lint:biome && npm run lint:eslint",
    "lint:biome": "biome check .",
    "lint:eslint": "eslint .",
    "lint:fix": "biome check --write . && eslint --fix .",
    "validate": "node actions_pipeline/validateConfig.ts",
    "rollup": "node actions_pipeline/rollupHistory.ts",
    "check-models": "node actions_pipeline/checkModels.ts",
    "schema": "node actions_pipeline/reactionStoreSchema.ts",
    "reflect": "node --env-file-if-exists=.env actions_pipeline/reflectLessons.ts",
    "dry-run": "node --env-file-if-exists=.env actions_pipeline/callOpenRouter.ts --dry-run",
    "generate:local": "node --env-file-if-exists=.env actions_pipeline/callOpenRouter.ts",
    "build:site": "vite build && node actions_pipeline/assembleSite.ts",
    "test:node": "node --test",
    "coverage": "npm run coverage:node && npm run coverage:web",
    "coverage:node": "node --test --experimental-test-coverage --test-coverage-lines=96 --test-coverage-branches=89 --test-coverage-functions=95",
    "coverage:web": "vitest run --coverage",
    "test:web": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.1",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.12.0",
    "jsdom": "^30.1.0",
    "playwright": "^1.63.0",
    "prettier": "3.9.8",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.3.0",
    "vitest": "^5.0.0"
  },
  "dependencies": {
    "@fontsource-variable/nunito": "^5.3.0",
    "@fontsource-variable/quicksand": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@sentry/react": "^10.75.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  }
}
